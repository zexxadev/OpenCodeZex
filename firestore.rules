rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidEmail(email) {
      return email is string &&
        email.size() <= 320 &&
        (email.size() == 0 || email.matches('^.+@.+\\..+$'));
    }

    function isValidUserProfileData(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId &&
        isValidEmail(data.email) &&
        data.displayName is string && data.displayName.size() <= 160 &&
        data.photoUrl is string && data.photoUrl.size() <= 1024 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserProfileUpdate(userId) {
      let data = request.resource.data;
      return isValidUserProfileData(data, userId) &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoUrl', 'updatedAt'
        ]) &&
        data.uid == resource.data.uid &&
        data.createdAt == resource.data.createdAt;
    }

    function isValidAppSettingsData(data, userId) {
      return data.keys().hasAll([
          'userId', 'themePreference', 'activeProfileId', 'selectedAgent',
          'selectedProviderId', 'selectedModelId', 'setupCompleted',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'themePreference', 'activeProfileId', 'selectedAgent',
          'selectedProviderId', 'selectedModelId', 'setupCompleted',
          'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        data.themePreference is string &&
        data.themePreference in ['DARK', 'LIGHT', 'MATERIAL_GLASS', 'MIUIX', 'SYSTEM'] &&
        data.activeProfileId is string && data.activeProfileId.size() <= 128 &&
        data.selectedAgent is string && data.selectedAgent.size() >= 1 && data.selectedAgent.size() <= 64 &&
        data.selectedProviderId is string && data.selectedProviderId.size() <= 128 &&
        data.selectedModelId is string && data.selectedModelId.size() <= 256 &&
        data.setupCompleted is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAppSettingsUpdate(userId) {
      let data = request.resource.data;
      return isValidAppSettingsData(data, userId) &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'themePreference', 'activeProfileId', 'selectedAgent',
          'selectedProviderId', 'selectedModelId', 'setupCompleted', 'updatedAt'
        ]) &&
        data.userId == resource.data.userId &&
        data.createdAt == resource.data.createdAt;
    }

    function isValidServerProfileData(data, userId) {
      return data.keys().hasAll([
          'userId', 'name', 'baseUrl', 'username', 'password',
          'directory', 'mode', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'name', 'baseUrl', 'username', 'password',
          'directory', 'mode', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.baseUrl is string && data.baseUrl.size() >= 1 && data.baseUrl.size() <= 512 &&
        data.username is string && data.username.size() <= 120 &&
        data.password is string && data.password.size() <= 512 &&
        data.directory is string && data.directory.size() <= 512 &&
        data.mode is string && data.mode in ['LOCAL_ANDROID', 'REMOTE_SERVER'] &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidServerProfileUpdate(userId) {
      let data = request.resource.data;
      return isValidServerProfileData(data, userId) &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'baseUrl', 'username', 'password', 'directory', 'mode', 'updatedAt'
        ]) &&
        data.userId == resource.data.userId &&
        data.createdAt == resource.data.createdAt;
    }

    function isValidProviderAccountData(data, userId) {
      return data.keys().hasAll([
          'userId', 'providerId', 'name', 'baseUrl', 'apiKey',
          'defaultModelId', 'apiFormat', 'envVarName', 'customFlag',
          'cachedModels', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'providerId', 'name', 'baseUrl', 'apiKey',
          'defaultModelId', 'apiFormat', 'envVarName', 'customFlag',
          'cachedModels', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.baseUrl is string && data.baseUrl.size() <= 512 &&
        data.apiKey is string && data.apiKey.size() <= 512 &&
        data.defaultModelId is string && data.defaultModelId.size() <= 256 &&
        data.apiFormat is string && data.apiFormat in ['OPENAI_COMPATIBLE', 'ANTHROPIC', 'GEMINI'] &&
        data.envVarName is string && data.envVarName.size() <= 128 &&
        data.customFlag is bool &&
        data.cachedModels is list && data.cachedModels.size() <= 200 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProviderAccountUpdate(userId) {
      let data = request.resource.data;
      return isValidProviderAccountData(data, userId) &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'providerId', 'name', 'baseUrl', 'apiKey', 'defaultModelId',
          'apiFormat', 'envVarName', 'customFlag', 'cachedModels', 'updatedAt'
        ]) &&
        data.userId == resource.data.userId &&
        data.createdAt == resource.data.createdAt;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfileData(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfileUpdate(userId);
      allow delete: if isOwner(userId);

      match /app_settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(settingId) && isValidAppSettingsData(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(settingId) && isValidAppSettingsUpdate(userId);
        allow delete: if isOwner(userId);
      }

      match /server_profiles/{profileId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(profileId) && isValidServerProfileData(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(profileId) && isValidServerProfileUpdate(userId);
        allow delete: if isOwner(userId);
      }

      match /provider_accounts/{accountId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId) && isValidProviderAccountData(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(accountId) && isValidProviderAccountUpdate(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
